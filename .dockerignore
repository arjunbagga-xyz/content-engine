# Never ship these into the build context or image
.venv/
node_modules/
outputs/
logs/
__pycache__/
*.pyc
.env
.env.local
*.sqlite3
*.sqlite
.git/
.github/
# Unrelated stray files NOT part of the engine
bjj_camila_lora_step1.1.7z
bjj_camila_lora_step1.1.png
