ContentEngine_Backup_*.zip

# Exclude data/ by default (regenerable, large), but KEEP the sprite + gameplay base-media
# needed for the faceless/sprite pipeline to work out of the box.
data/
!data/sprites/
!data/sprites_clean/
!data/gameplay/

# Docker own files (avoid recursion)
Dockerfile
.dockerignore
